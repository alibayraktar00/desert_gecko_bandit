# Metin dosyalarında satır sonlarını git yönetsin
* text=auto

# Unity YAML dosyaları birleştirilirken bozulmasın
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.meta text eol=lf

# İkili dosyalar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
graphify-out/graph.json merge=graphify
